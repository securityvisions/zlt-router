#!/bin/sh /etc/rc.common
# x28-watchdog — automatic cellular operator failover daemon.
# Monitors data connectivity and switches between MCI (preferred) and
# Rightel (fallback) via the vendor select API when data dies.
# Never uses the PLMN lock. See /data/proxy/operator-watchdog.sh.

USE_PROCD=1
START=99
STOP=15

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /data/proxy/operator-watchdog.sh
    procd_set_param respawn 3600 10 5
    procd_close_instance
}

stop_service() {
    pgrep -f 'operator-watchdog.sh' | xargs -r kill 2>/dev/null
    return 0
}
