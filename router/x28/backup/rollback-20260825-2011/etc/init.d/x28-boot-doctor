#!/bin/sh /etc/rc.common
# x28-boot-doctor — one-shot post-boot convergence verify + repair.
# Runs ~90s after boot (after the full custom service set), checks the
# health gate, repairs known boot races, sends ONE Telegram verdict card,
# then exits. procd: no respawn — a genuine one-shot.

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /data/proxy/x28-boot-doctor.sh run
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
