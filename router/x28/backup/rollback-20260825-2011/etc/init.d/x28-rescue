#!/bin/sh /etc/rc.common
# x28-rescue — collected-node rescue: admission + world supervision (60s loop).

START=97
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /data/proxy/x28-rescue.sh loop
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
