#!/bin/sh /etc/rc.common
# x28-telemetry — hourly telemetry + history (procd, boot-enabled).
START=96
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c 'while :; do sh /data/proxy/x28-telemetry.sh >/dev/null 2>&1; sleep 3600; done'
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
