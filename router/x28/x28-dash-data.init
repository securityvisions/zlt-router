#!/bin/sh /etc/rc.common
# x28-dash-data — Dashboard JSON snapshot generator (read-only, 60s loop).

START=96
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /data/proxy/x28-dash-data.sh loop
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
