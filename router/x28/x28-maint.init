#!/bin/sh /etc/rc.common
# x28-maint — maintenance auto-reboot window (Sunday 05:00, qualified).
# Checks every 10 min; acts only in-window with qualifier + sane clock;
# marker prevents double-fire per ISO week.

START=97
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /data/proxy/x28-maint.sh loop
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
