#!/bin/sh /etc/rc.common
# x28-drift — nightly config backup + drift alert (age-gated hourly loop).

START=97
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /data/proxy/x28-drift.sh loop
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
