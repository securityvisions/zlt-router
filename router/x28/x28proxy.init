#!/bin/sh /etc/rc.common
# x28proxy — X28 crypto-engine service (xray-core SOCKS inbound -> VPS tunnel).
# Template: deploy to the X28 as /etc/init.d/x28proxy with the real
# /data/proxy/sing-box/xray-proxy.json in place (secrets filled on device).
USE_PROCD=1
START=98
STOP=12

start_service() {
    procd_open_instance
    procd_set_param command /data/proxy/xray
    procd_append_param command run
    procd_append_param command -config /data/proxy/sing-box/xray-proxy.json
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
