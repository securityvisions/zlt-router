#!/bin/sh /etc/rc.common
# x28-budget-refresh — periodic balance report cache refresh.
# Runs balance.sh --report every 15 minutes to keep /tmp/balance_report
# fresh, so the budget hero widget and budget card always show current data.

START=95
USE_PROCD=1

start_service() {
    # populate cache immediately at boot
    sh /root/balance.sh --report >/dev/null 2>&1 || true
    procd_open_instance
    procd_set_param command /bin/sh -c '
        while :; do
            sleep 900
            sh /root/balance.sh --report >/dev/null 2>&1 || true
        done'
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
