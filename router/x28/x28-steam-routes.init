#!/bin/sh /etc/rc.common
# x28-steam-routes — keep Steam/Valve tun routes applied across WAN events.
# The enable script is idempotent; the loop just re-asserts it periodically.

START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /data/proxy/steam-tun-loop.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
