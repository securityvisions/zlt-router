
config adblock-fast 'config'
	option enabled '1'
	list allowed_domain 'cdn.jsdelivr.net'
	list allowed_domain 't.co'
	list allowed_domain 'x.com'
	list allowed_domain 'twitter.com'
	list allowed_domain 'twimg.com'
	list allowed_domain 'shaparak.ir'
	list allowed_domain 'bmi.ir'
	list allowed_domain 'bankmellat.ir'
	list allowed_domain 'bki.ir'
	list allowed_domain 'sb24.ir'
	list allowed_domain 'sep.ir'
	list allowed_domain 'pep.co.ir'
	list allowed_domain 'behpardakht.com'
	list allowed_domain 'asanpardakht.ir'
	list allowed_domain 'sadadpsp.ir'
	list allowed_domain 'parsian-bank.ir'
	list allowed_domain 'zarinpal.com'
	list allowed_domain 'iau.ir'
	list allowed_domain 'srbiau.ac.ir'
	list allowed_domain 'ut.ac.ir'
	list allowed_domain 'aut.ac.ir'
	list allowed_domain 'sharif.edu'
	list allowed_domain 'tax.gov.ir'
	list allowed_domain 'my.gov.ir'
	list allowed_domain 'snapp.ir'
	list allowed_domain 'divar.ir'
	list allowed_domain 'digikala.com'
	list allowed_domain 'torob.com'
	list allowed_domain 'telewebion.com'
	list allowed_domain 'telewebion.net'
	option allow_non_ascii '0'
	option canary_domains_icloud '0'
	option canary_domains_mozilla '0'
	option compressed_cache '0'
	option compressed_cache_dir '/etc'
	option config_update_enabled '0'
	option config_update_url 'https://cdn.jsdelivr.net/gh/openwrt/packages/net/adblock-fast/files/adblock-fast.config.update'
	option curl_max_file_size '30000000'
	option curl_retry '3'
	option debug_init_script '0'
	option debug_performance '0'
	option dns 'dnsmasq.servers'
	list dnsmasq_instance '*'
	option download_connect_timeout '10'
	option download_timeout '10'
	option download_allow_insecure '1'
	option force_dns '1'
	list force_dns_port '53'
	list force_dns_port '853'
	option parallel_downloads '8'
	option pause_timeout '60'
	option procd_trigger_wan6 '0'
	option procd_boot_wan_timeout '60'
	option verbosity '2'
	option heartbeat_domain 'heartbeat.mossdef.org'
	option heartbeat_sleep_timeout '10'
	option update_config_sizes '1'
	option dnsmasq_sanity_check '1'
	option config_compat '17'
	option config_version '1.2.4-r4'
	option rpcd_token '6XNsyrgId8Uyri9wmId4nOdD'
	list blocked_domain 'yektanet.com'
	list blocked_domain 'api.yektanet.com'
	list blocked_domain 'cdn.yektanet.com'
	list blocked_domain 'tapsell.ir'
	list blocked_domain 'api.tapsell.ir'
	list blocked_domain 'storage.tapsell.ir'
	list blocked_domain 'sabavision.com'
	list blocked_domain 'api.sabavision.com'
	list blocked_domain 'mediaad.org'
	list blocked_domain 's1.mediaad.org'
	list blocked_domain 'kaprila.com'
	list blocked_domain 'clickyab.com'
	list blocked_domain 'najva.com'
	list blocked_domain 'api.najva.com'
	list blocked_domain 'push-notification.net'
	list blocked_domain 'chabok.io'
	list blocked_domain 'adtrace.io'
	list blocked_domain 'adtrace.org'
	list blocked_domain 'metrix.ir'
	list blocked_domain 'analytics.metrix.ir'
	list blocked_domain 'adclick.ir'
	list blocked_domain 'sanjagh.pro'
	list blocked_domain 'dehkadeh.org'
	list blocked_domain 'zarpop.com'
	list blocked_domain 'farsclicks.com'
	list blocked_domain 'adnegah.net'
	list blocked_domain 'anetwork.ir'
	list blocked_domain 'vclick.ir'

config file_url
	option name 'Hagezi - Pro'
	option url 'https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/wildcard/pro-onlydomains.txt'
	option size '3476485'
	option action 'block'
	option enabled '0'

config file_url
	option name 'AdguardTeam - CNAME Trackers'
	option url 'https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_trackers_justdomains.txt'
	option size '6241707'
	option action 'block'
	option enabled '0'

config file_url
	option name 'OISD - Big'
	option url 'https://big.oisd.nl/'
	option size '6163363'
	option action 'block'
	option enabled '0'

config file_url
	option name 'StevenBlack - Unified hosts'
	option url 'https://cdn.jsdelivr.net/gh/StevenBlack/hosts/hosts'
	option size '4790642'
	option action 'block'
	option enabled '0'

config file_url
	option name '1Hosts - Lite'
	option url 'https://o0.pages.dev/Lite/domains.txt'
	option size '2786010'
	option action 'block'
	option enabled '0'

config file_url
	option name 'Bongochong - Combined Privacy Block Lists (TLD Optimized)'
	option url 'https://cdn.jsdelivr.net/gh/bongochong/CombinedPrivacyBlockLists/NoFormatting/cpbl-ctld.txt'
	option size '2608152'
	option action 'block'
	option enabled '0'

config file_url
	option name 'CERT Polska - Dangerous Websites'
	option url 'https://hole.cert.pl/domains/v2/domains.txt'
	option size '731479'
	option action 'block'
	option enabled '0'

config file_url
	option name 'Kboghdady - YouTube Ads DNS'
	option url 'https://cdn.jsdelivr.net/gh/kboghdady/youTube_ads_4_pi-hole/black.list'
	option size '553006'
	option action 'block'
	option enabled '0'

config file_url
	option name 'AdguardTeam - CNAME Clickthroughs'
	option url 'https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_clickthroughs_justdomains.txt'
	option size '362170'
	option action 'block'
	option enabled '0'

config file_url
	option name 'SomeoneWhoCares - Hosts'
	option url 'https://someonewhocares.org/hosts/hosts'
	option size '347410'
	option action 'block'
	option enabled '0'

config file_url
	option name 'WinHelp2002 MVPS - Hosts'
	option url 'https://winhelp2002.mvps.org/hosts.txt'
	option size '334861'
	option action 'block'
	option enabled '0'

config file_url
	option name 'AdAway - Hosts'
	option url 'https://adaway.org/hosts.txt'
	option size '243454'
	option action 'block'
	option enabled '1'

config file_url
	option name 'AdguardTeam - CNAME Ads'
	option url 'https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_ads_justdomains.txt'
	option size '222595'
	option action 'block'
	option enabled '0'

config file_url
	option name 'AdguardTeam - CNAME Microsites'
	option url 'https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_microsites_justdomains.txt'
	option size '123275'
	option action 'block'
	option enabled '0'

config file_url
	option name 'Yoyo.org - Hosts'
	option url 'https://pgl.yoyo.org/as/serverlist.php?hostformat=hosts&showintro=1&mimetype=plaintext'
	option size '95221'
	option action 'block'
	option enabled '1'

config file_url
	option name 'Hoshsadiq - NoCoin Adblock List'
	option url 'https://cdn.jsdelivr.net/gh/hoshsadiq/adblock-nocoin-list/hosts.txt'
	option size '11149'
	option action 'block'
	option enabled '0'

